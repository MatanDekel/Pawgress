rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function trainerOf(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data.trainerId;
    }

    // Profiles: any signed-in user can read; only the owner writes their own.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Trainer codes: create-once, never changed or reused.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if false;
    }

    // Daily logs: the dog owner writes; the owner and their linked trainer read.
    match /logs/{uid}/days/{day} {
      allow write: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || trainerOf(uid) == request.auth.uid);
    }

    // Trainer's lesson library (folders + lessons): the trainer writes;
    // the trainer and their linked clients read.
    match /trainers/{tid}/{coll}/{id} {
      allow write: if signedIn() && request.auth.uid == tid;
      allow read: if signedIn() && (request.auth.uid == tid || trainerOf(request.auth.uid) == tid);
    }

    // Homework calendar: the client and their linked trainer both read and write
    // (trainer assigns, marks seen, adds notes; client marks done, attaches videos).
    match /homework/{uid}/days/{day} {
      allow read, write: if signedIn() && (request.auth.uid == uid || trainerOf(uid) == request.auth.uid);
    }

    // Goals and scheduled sessions: the trainer writes; the client and trainer read.
    match /plans/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || trainerOf(uid) == request.auth.uid);
      allow write: if signedIn() && trainerOf(uid) == request.auth.uid;
    }

    // Payment tracking: trainer only.
    match /billing/{uid} {
      allow read, write: if signedIn() && trainerOf(uid) == request.auth.uid;
    }
  }
}
